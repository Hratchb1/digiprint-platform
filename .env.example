# Copy this to .env and fill in your values
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/digiprint

# Store this app is running for (used as default if multi-store not yet set up)
DEFAULT_STORE=Bondi

# Secret key for sessions (change this to a random string)
SECRET_KEY=change-me-to-a-random-string-in-production

# Set to 1 to pause all outbound emails (same as Sheets "Pause Emails")
PAUSE_EMAILS=0
